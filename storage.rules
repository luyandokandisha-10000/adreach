rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Ad creatives: publicly readable image assets
    match /ad-creatives/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Default rule
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
