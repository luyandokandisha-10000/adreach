rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Ads collection: anyone can read approved public ads; authenticated users can submit
    match /ads/{adId} {
      allow read: if true;
      allow create: if request.resource.data.headline is string
                    && request.resource.data.copy is string
                    && request.resource.data.headline.size() > 0
                    && request.resource.data.headline.size() <= 300
                    && request.resource.data.copy.size() <= 5000;
      allow update, delete: if isSignedIn();
    }

    // Communities & directory: public read
    match /communities/{communityId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Distribution events: logged per ad broadcast
    match /distribution_events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn() || request.resource.data.adId is string;
      allow update, delete: if isSignedIn();
    }

    // User accounts / profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Payment verification records: write restricted
    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }
  }
}
