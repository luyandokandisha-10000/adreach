# ==========================================
# AdReach Zambia - Environment Configuration
# ==========================================

# Port and Base URL configuration
PORT=3000
BASE_PATH=/

# Authentication (Clerk)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key
# VITE_CLERK_PROXY_URL=

# Firebase Client Configuration (Firebase Console -> Project Settings -> General -> Your apps)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=adreachzm.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=adreachzm
VITE_FIREBASE_STORAGE_BUCKET=adreachzm.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# AdReach API Endpoint
VITE_API_BASE_URL=http://localhost:3000
